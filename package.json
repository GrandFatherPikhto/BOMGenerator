{
  "name": "bom-generator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MERN BOM editor for KiCad CSV exports (boards, sellers, categories, common purchases)",
  "engines": {
    "node": ">=24.21.0"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch --watch-preserve-output src/server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node src/server/index.js",
    "seed": "node scripts/seed.js",
    "migrate": "node scripts/migrate.js",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.js\" && vitest run",
    "test:unit": "node --test \"tests/shared/**/*.test.js\"",
    "test:api": "node --test --test-concurrency=1 \"tests/api/**/*.test.js\"",
    "test:client": "vitest run",
    "test:coverage": "node --test --experimental-test-coverage --test-concurrency=1 \"tests/shared/**/*.test.js\" \"tests/api/**/*.test.js\"",
    "test:coverage:client": "vitest run --coverage"
  },
  "dependencies": {
    "@emotion/react": "^11.13.3",
    "@emotion/styled": "^11.13.0",
    "@mui/icons-material": "^6.1.6",
    "@mui/material": "^6.1.6",
    "cors": "^2.8.5",
    "csv-parse": "^5.5.6",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.1",
    "mongoose": "^8.7.3",
    "multer": "^2.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@vitejs/plugin-react": "^4.3.3",
    "@vitest/coverage-v8": "^2.1.9",
    "concurrently": "^9.0.1",
    "jsdom": "^30.1.1",
    "supertest": "^7.0.0",
    "vite": "^5.4.10",
    "vitest": "^2.1.9"
  }
}
