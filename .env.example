# Copy to `.env` and adjust if needed.
# MongoDB must be running: sudo systemctl start mongod
MONGODB_URI=mongodb://127.0.0.1:27017/bom-generator

# HTTP port of the Express API (the Vite dev server proxies /api here).
PORT=3000

# Database used by the integration test runner (dropped before and after).
MONGODB_URI_TEST=mongodb://127.0.0.1:27017/bom-generator-test

# --- Authentication (optional) -------------------------------------------
# Users live in a JSON file with scrypt hashes; when the file is missing or has
# no users the API stays open. Generate a hash with:  npm run auth:hash
# AUTH_FILE=auth.json

# Required as soon as AUTH_FILE has users (>= 32 random bytes, base64url):
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# SESSION_SECRET=

# Send the session cookie only over HTTPS (defaults to on in production).
# COOKIE_SECURE=1

# Optional: allow a client served from another origin (comma-separated).
# CORS_ORIGIN=
